# Server-only signing/encryption key. Generate with: openssl rand -hex 32
# Configure the same persistent value for preview and production.
# Never use a VITE_ prefix or commit the real value.
PROGRESS_SESSION_SECRET=

# Preparation only. Keep anonymous until migration and account pages are ready.
DEVOCIONAL_ACCESS_MODE=anonymous
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Future payment processor only; never use this key for user progress queries.
SUPABASE_SERVICE_ROLE_KEY=
